# SampAudience server settings. Only MONGODB_URL is needed to start.
# API keys and connections (SUPPLY360, Claude, connected systems) are entered in the console under
# Settings and kept in the database (docs/SETTINGS.md). The ones below still work as a fallback.
# MongoDB 7 or later, run as a replica set (one node is enough): transactions need it.
# DATABASE_URL is read as a fallback for older setups.
MONGODB_URL=mongodb://localhost:27017/sampleon?replicaSet=rs0
PORT=4600
# Public address: survey-card links (/go/{token}) and browser returns (/r/{status}) use it.
PUBLIC_URL=http://localhost:4600

# Optional (recommended in production): seals the secrets saved in Settings. 32+ random characters,
# e.g. openssl rand -hex 32. Unset: a key is created on first start and kept in the database.
# Set it before saving any secret: secrets saved under another key must be entered again.
SETTINGS_ENCRYPTION_KEY=

# Fallback only: enter these in the console (Settings > SUPPLY360 connection) instead.
# SUPPLY360_URL=http://localhost:4000
# SUPPLY360_CLIENT_ID=sampleon
# SUPPLY360_SECRET=

# Survey-host client used when a request does not name survey.hostId.
DEFAULT_SURVEY_HOST=zapx

# Feasibility and invitations
DEFAULT_RESPONSE_RATE=0.12
FATIGUE_MAX_INVITES=3
FATIGUE_WINDOW_DAYS=7
ACTIVE_WITHIN_DAYS=90
MAX_BATCH_SIZE=5000
AUTO_BATCH_INTERVAL_MINUTES=60
MAX_ROUTE_HOPS=3
# Where a respondent lands when no other survey fits (optional).
PANEL_END_URL=

# Background worker (batches, outbox). WORKER_INLINE=false runs no worker in this process.
WORKER_INTERVAL_MS=2000

# Natural-language targeting: rules always; Claude when configured. Its drafts must pass the same checks.
# Fallback only: enter the key in the console (Settings > AI audience drafting) instead.
# AI_PROVIDER=rules
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
